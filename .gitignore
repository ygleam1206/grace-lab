# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# database
/data/*
!/data/.gitkeep

# uploads
/uploads/*
!/uploads/.gitkeep

# 照片源文件（只保留在本地，不提交到仓库）
/public/photos/*
!/public/photos/.gitkeep
/public-site/public/images/photos/*
!/public-site/public/images/photos/.gitkeep

# public site（app/*.json 和 public/uploads 需要提交供 Actions 构建；out 由 Actions 构建，不提交）
/public-site/node_modules
/public-site/.next
/public-site/out
/public-site/data
